<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <None Update="Data\Statistics\master_plus.json"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Update="Data\Statistics\manifest.json"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Update="Data\Statistics\master_plus_legacy_backup.json"
          CopyToOutputDirectory="Never"
          CopyToPublishDirectory="Never" />
    <None Update="Data\Champions\champions.ko.json"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Update="Data\Champions\Icons\*.png"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Tools\**\*.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <Page Remove="Views\DeveloperTestWindow.xaml;Views\Controls\SearchableChampionPicker.xaml" />
    <Compile Remove="Views\DeveloperTestWindow.xaml.cs;Views\Controls\SearchableChampionPicker.xaml.cs" />
    <Compile Remove="Models\Development\**\*.cs;Services\Development\**\*.cs;Services\MatchupStatisticsDebugValidator.cs" />
  </ItemGroup>

</Project>
