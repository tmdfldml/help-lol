<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <AssemblyName>LoLMatchInfo</AssemblyName>
    <RootNamespace>LoLMatchup</RootNamespace>
    <Product>LoL Match Info</Product>
    <AssemblyTitle>LoL Match Info</AssemblyTitle>
    <Description>Windows companion for League of Legends matchup information.</Description>
    <Company>LoL Match Info contributors</Company>
    <Authors>LoL Match Info contributors</Authors>
    <Copyright>Copyright © 2026 LoL Match Info contributors</Copyright>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>$(AssemblyVersion)</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <None Update="Data\ChampionSkills\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="Data\Statistics\master_plus.json"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Update="Data\Statistics\manifest.json"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Update="Data\Statistics\master_plus_legacy_backup.json"
          CopyToOutputDirectory="Never"
          CopyToPublishDirectory="Never" />
    <None Update="Data\Champions\champions.ko.json"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Update="Data\Champions\Icons\*.png"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Tools\**\*.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <Page Remove="Views\DeveloperTestWindow.xaml;Views\Controls\SearchableChampionPicker.xaml" />
    <Compile Remove="Views\DeveloperTestWindow.xaml.cs;Views\Controls\SearchableChampionPicker.xaml.cs" />
    <Compile Remove="Models\Development\**\*.cs;Services\Development\**\*.cs;Services\MatchupStatisticsDebugValidator.cs" />
  </ItemGroup>

</Project>
