<Window x:Class="LoLMatchup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:LoLMatchup.Views"
        Title="LoL Matchup" Height="820" Width="440"
        MinHeight="760" MinWidth="420" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen" Background="#0D1118">
    <Grid x:Name="RootLayout" Margin="24,18,24,20"
          SizeChanged="RootLayout_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <TextBlock Text="LoL Matchup" FontSize="25" FontWeight="Bold" />
            <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                    Padding="9,4" Background="#171D27" CornerRadius="10"
                    BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                <TextBlock Text="LIVE" FontSize="10" FontWeight="SemiBold"
                           Foreground="{StaticResource GoldAccentBrush}" />
            </Border>
        </Grid>

        <Border x:Name="StatusPanel" Grid.Row="1" HorizontalAlignment="Stretch"
                VerticalAlignment="Center" Padding="28,24"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1" CornerRadius="12">
            <StackPanel>
                <TextBlock Text="{Binding StatusText, FallbackValue=게임을 기다리는 중...}"
                           Foreground="{StaticResource GoldAccentBrush}"
                           FontSize="15" FontWeight="SemiBold"
                           TextAlignment="Center" TextWrapping="Wrap" />
                <TextBlock Text="{Binding StatusDetailText, FallbackValue=리그 오브 레전드 게임이 시작되면 매치업 통계를 자동으로 표시합니다.}"
                           Margin="0,8,0,0" Style="{StaticResource SecondaryTextStyle}"
                           TextAlignment="Center" TextWrapping="Wrap" LineHeight="19" />
            </StackPanel>
        </Border>

        <Grid x:Name="StatisticsPanel" Grid.Row="1" Margin="0,14,0,0"
              Visibility="Collapsed">
            <views:PortraitStatisticsView x:Name="PortraitStatisticsView" />
            <views:LandscapeStatisticsView x:Name="LandscapeStatisticsView"
                                           Visibility="Collapsed" />
        </Grid>
    </Grid>
</Window>
