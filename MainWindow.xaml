<Window x:Class="LoLMatchup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:LoLMatchup.Views"
        Title="LoL Match Info" Height="820" Width="440"
        MinHeight="760" MinWidth="420" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen" Background="#0D1118"
        PreviewKeyDown="MainWindow_PreviewKeyDown">
    <Grid x:Name="RootLayout" Margin="18,18,18,20" SizeChanged="RootLayout_SizeChanged">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button x:Name="NavigationButton" Content="&#x2630;" ToolTip="메뉴"
                    Style="{StaticResource ShellIconButtonStyle}" Click="NavigationButton_Click"/>
            <TextBlock Grid.Column="1" Text="LoL Match Info" FontSize="19" FontWeight="Bold"
                       Margin="8,0,4,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Border VerticalAlignment="Center" Padding="8,4" Background="#171D27"
                        CornerRadius="10" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                    <TextBlock x:Name="ModeBadgeText" Text="WAITING" FontSize="9"
                               FontWeight="SemiBold" Foreground="{StaticResource GoldAccentBrush}"/>
                </Border>
                <Button x:Name="DeveloperTestButton" Content="TEST" Margin="5,0,0,0"
                        Padding="7,3" FontSize="9" Visibility="Collapsed"
                        Style="{StaticResource ShellButtonStyle}" Click="DeveloperTestButton_Click"/>
                <ToggleButton x:Name="AlwaysOnTopToggle" Content="PIN" Margin="5,0,0,0"
                              Padding="7,3" FontSize="9" ToolTip="항상 위에 표시"
                              Style="{StaticResource ShellToggleButtonStyle}"
                              Checked="AlwaysOnTopToggle_Changed" Unchecked="AlwaysOnTopToggle_Changed">
                </ToggleButton>
                <Button x:Name="SettingsButton" Content="&#x2699;" Margin="5,0,0,0"
                        ToolTip="설정" Style="{StaticResource ShellIconButtonStyle}"
                        Click="SettingsButton_Click"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,14,0,0">
            <views:HomeView x:Name="HomeView"/>
            <views:InGameView x:Name="InGameView" Visibility="Collapsed"/>
            <views:MatchupDetailView x:Name="MatchupDetailView" Visibility="Collapsed"/>
        </Grid>

        <Grid x:Name="NavigationOverlay" Grid.RowSpan="2" Panel.ZIndex="20" Visibility="Collapsed">
            <Button Background="#99000000" BorderThickness="0" Click="DrawerBackdrop_Click"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
            <Border Width="210" HorizontalAlignment="Left" Background="#121923"
                    BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8"
                    Padding="14" Margin="0,34,0,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Margin="6,3,0,15">
                        <TextBlock Text="LoL Match Info" FontSize="17" FontWeight="Bold"/>
                        <TextBlock x:Name="CurrentPageText" Text="홈" Margin="0,3,0,0" Style="{StaticResource MutedTextStyle}"/>
                    </StackPanel>
                    <ToggleButton x:Name="HomeNavigationItem" Grid.Row="1" Content="홈" IsChecked="True"
                                  Style="{StaticResource NavigationItemStyle}" Click="HomeNavigation_Click"/>
                    <ToggleButton x:Name="InGameNavigationItem" Grid.Row="2" Content="인게임"
                                  Style="{StaticResource NavigationItemStyle}" Margin="0,5,0,0" Click="InGameNavigation_Click"/>
                    <Button Grid.Row="4" Content="설정" Style="{StaticResource ShellButtonStyle}"
                            HorizontalContentAlignment="Left" Padding="15,10" Click="DrawerSettings_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
