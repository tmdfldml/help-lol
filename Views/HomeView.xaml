<UserControl x:Class="LoLMatchup.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="760" Margin="0,12,0,0">
            <TextBlock Text="홈" FontSize="20" FontWeight="Bold" Margin="2,0,0,16"/>
            <Border Style="{StaticResource CardStyle}" Padding="22,24">
                <StackPanel>
                    <TextBlock Text="현재 상태" Style="{StaticResource SecondaryTextStyle}"/>
                    <TextBlock x:Name="GameStatusText" Text="게임을 기다리는 중입니다"
                               Margin="0,10,0,0" Foreground="{StaticResource GoldAccentBrush}"
                               FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="GameStatusDetailText"
                               Text="앱을 켜 둔 채 League 게임을 시작하면 자동으로 감지합니다."
                               Margin="0,10,0,0" Style="{StaticResource SecondaryTextStyle}" FontSize="13"
                               TextWrapping="Wrap" LineHeight="21"/>
                    <Button Content="인게임 보기  →" Margin="0,20,0,0" Padding="14,10"
                            Style="{StaticResource ShellButtonStyle}"
                            HorizontalAlignment="Left" Click="OpenInGame_Click"/>
                </StackPanel>
            </Border>
            <StackPanel Margin="22,22,22,24">
                <TextBlock Text="게임이 시작되면" FontSize="14" FontWeight="SemiBold"/>
                <TextBlock Text="게임 자동 감지  →  인게임에서 매치업 확인" Margin="0,8,0,0"
                           Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"/>
                <TextBlock Text="5개 포지션의 결과·초반·교전 경향을 비교하고, 카드를 눌러 상세 통계를 확인하세요."
                           Margin="0,8,0,0" Style="{StaticResource MutedTextStyle}" FontSize="12"
                           TextWrapping="Wrap" LineHeight="20"/>
            </StackPanel>
            <Border Style="{StaticResource CardStyle}" Padding="22,16">
                <StackPanel>
                    <TextBlock Text="적용 중인 통계" Style="{StaticResource SecondaryTextStyle}"/>
                    <WrapPanel Margin="0,7,0,0">
                        <TextBlock x:Name="DatasetPatchText" Text="데이터 확인 중" Margin="0,0,16,0"/>
                        <TextBlock x:Name="DatasetMatchesText" Style="{StaticResource MutedTextStyle}"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
