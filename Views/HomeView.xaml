<UserControl x:Class="LoLMatchup.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="1">
            <TextBlock Text="홈" FontSize="20" FontWeight="Bold" Margin="2,0,0,4"/>
            <TextBlock Text="게임 중 상대 매치업 정보를 자동으로 표시합니다."
                       Style="{StaticResource MutedTextStyle}" Margin="2,0,0,14"/>
            <Border Style="{StaticResource CardStyle}" Padding="22,20">
                <StackPanel>
                    <TextBlock Text="게임 상태" Style="{StaticResource SecondaryTextStyle}"/>
                    <TextBlock x:Name="GameStatusText" Text="게임을 기다리는 중"
                               Margin="0,10,0,0" Foreground="{StaticResource GoldAccentBrush}"
                               FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock x:Name="GameStatusDetailText"
                               Text="League of Legends 게임을 감지하면 자동으로 인게임 화면으로 이동합니다."
                               Margin="0,7,0,0" Style="{StaticResource MutedTextStyle}"
                               TextWrapping="Wrap" LineHeight="18"/>
                    <Button Content="인게임 보기" Margin="0,16,0,0" Padding="12,8"
                            Style="{StaticResource ShellButtonStyle}"
                            HorizontalAlignment="Left" Click="OpenInGame_Click"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Padding="22,18" Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="통계 데이터" Style="{StaticResource SecondaryTextStyle}"/>
                        <TextBlock x:Name="DatasetPatchText" Text="데이터 확인 중..."
                                   Margin="0,8,0,0" FontSize="15" FontWeight="SemiBold"/>
                    </StackPanel>
                    <TextBlock x:Name="DatasetMatchesText" Grid.Column="1" Text=""
                               VerticalAlignment="Bottom" Foreground="{StaticResource QueryAccentBrush}"
                               FontWeight="SemiBold"/>
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
