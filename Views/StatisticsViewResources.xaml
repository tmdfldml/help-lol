<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:LoLMatchup.Views.Controls"
                    xmlns:statistics="clr-namespace:LoLMatchup.Models.Statistics"
                    xmlns:presentation="clr-namespace:LoLMatchup.Models.Presentation">
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F1F4F8" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#A5AFBD" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#929EAF" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#171D27" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#27303E" />
    <SolidColorBrush x:Key="QueryAccentBrush" Color="#82B8C5" />
    <SolidColorBrush x:Key="OpponentAccentBrush" Color="#B7A5CE" />
    <SolidColorBrush x:Key="GoldAccentBrush" Color="#D6B66B" />

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
    </Style>
    <Style x:Key="SecondaryTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style x:Key="MutedTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="FontSize" Value="11" />
    </Style>
    <Style x:Key="ReliabilityBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="#1B2531" />
        <Setter Property="BorderBrush" Value="#41566A" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Padding" Value="5,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasReliability}" Value="False">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="ReliabilityBadgeTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#AFC3D6" />
        <Setter Property="FontSize" Value="9" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="OutcomeBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="#202630" />
        <Setter Property="BorderBrush" Value="#48515E" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Padding" Value="5,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasOutcomeEvaluation}" Value="False">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding OutcomeAdvantageLevel}"
                         Value="{x:Static statistics:OutcomeAdvantageLevel.AllyAdvantage}">
                <Setter Property="Background" Value="#162A30" />
                <Setter Property="BorderBrush" Value="{StaticResource QueryAccentBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding OutcomeAdvantageLevel}"
                         Value="{x:Static statistics:OutcomeAdvantageLevel.EnemyAdvantage}">
                <Setter Property="Background" Value="#282332" />
                <Setter Property="BorderBrush" Value="{StaticResource OpponentAccentBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="OutcomeBadgeTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
        <Setter Property="FontSize" Value="9" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding OutcomeAdvantageLevel}"
                         Value="{x:Static statistics:OutcomeAdvantageLevel.AllyAdvantage}">
                <Setter Property="Foreground" Value="{StaticResource QueryAccentBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding OutcomeAdvantageLevel}"
                         Value="{x:Static statistics:OutcomeAdvantageLevel.EnemyAdvantage}">
                <Setter Property="Foreground" Value="{StaticResource OpponentAccentBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding OutcomeAdvantageLevel}"
                         Value="{x:Static statistics:OutcomeAdvantageLevel.InsufficientEvidence}">
                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="LevelTempoTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
        <Setter Property="FontSize" Value="9" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding LevelTempoLevel}"
                         Value="{x:Static statistics:LevelTempoLevel.AllyTendency}">
                <Setter Property="Foreground" Value="{StaticResource QueryAccentBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding LevelTempoLevel}"
                         Value="{x:Static statistics:LevelTempoLevel.EnemyTendency}">
                <Setter Property="Foreground" Value="{StaticResource OpponentAccentBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding LevelTempoLevel}"
                         Value="{x:Static statistics:LevelTempoLevel.InsufficientEvidence}">
                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="CombatPressureTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
        <Setter Property="FontSize" Value="9" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding CombatPressureLevel}"
                         Value="{x:Static statistics:CombatPressureLevel.AllyTendency}">
                <Setter Property="Foreground" Value="{StaticResource QueryAccentBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding CombatPressureLevel}"
                         Value="{x:Static statistics:CombatPressureLevel.EnemyTendency}">
                <Setter Property="Foreground" Value="{StaticResource OpponentAccentBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding CombatPressureLevel}"
                         Value="{x:Static statistics:CombatPressureLevel.InsufficientEvidence}">
                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="PortraitDirectionChipStyle" TargetType="Border">
        <Setter Property="Background" Value="#1D232D" />
        <Setter Property="BorderBrush" Value="#35404E" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="Margin" Value="0,0,5,0" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Level}"
                         Value="{x:Static presentation:CompactDirectionLevel.Ally}">
                <Setter Property="Background" Value="#162A30" />
                <Setter Property="BorderBrush" Value="#486570" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Level}"
                         Value="{x:Static presentation:CompactDirectionLevel.Enemy}">
                <Setter Property="Background" Value="#282332" />
                <Setter Property="BorderBrush" Value="#60576F" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="PortraitDirectionChipTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
        <Setter Property="FontSize" Value="9" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Level}"
                         Value="{x:Static presentation:CompactDirectionLevel.Ally}">
                <Setter Property="Foreground" Value="{StaticResource QueryAccentBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Level}"
                         Value="{x:Static presentation:CompactDirectionLevel.Enemy}">
                <Setter Property="Foreground" Value="{StaticResource OpponentAccentBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Level}"
                         Value="{x:Static presentation:CompactDirectionLevel.Unavailable}">
                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <DataTemplate x:Key="PortraitDirectionChipTemplate">
        <Border Style="{StaticResource PortraitDirectionChipStyle}" ToolTip="L2·L3·L6은 해당 레벨에 먼저 도달한 쪽의 경향입니다. 솔로킬은 15분 이전 도움 없이 직접 맞상대를 처치한 횟수 기준입니다.">
            <TextBlock Text="{Binding Text}"
                       Style="{StaticResource PortraitDirectionChipTextStyle}" />
        </Border>
    </DataTemplate>
    <Style x:Key="TeamOutcomeSummaryBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="#202630" />
        <Setter Property="BorderBrush" Value="#48515E" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Padding" Value="6,1" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding OutcomeSummaryLevel}"
                         Value="{x:Static statistics:TeamOutcomeSummaryLevel.AllyTendency}">
                <Setter Property="Background" Value="#162A30" />
                <Setter Property="BorderBrush" Value="{StaticResource QueryAccentBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding OutcomeSummaryLevel}"
                         Value="{x:Static statistics:TeamOutcomeSummaryLevel.EnemyTendency}">
                <Setter Property="Background" Value="#282332" />
                <Setter Property="BorderBrush" Value="{StaticResource OpponentAccentBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="TeamOutcomeSummaryTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding OutcomeSummaryLevel}"
                         Value="{x:Static statistics:TeamOutcomeSummaryLevel.AllyTendency}">
                <Setter Property="Foreground" Value="{StaticResource QueryAccentBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding OutcomeSummaryLevel}"
                         Value="{x:Static statistics:TeamOutcomeSummaryLevel.EnemyTendency}">
                <Setter Property="Foreground" Value="{StaticResource OpponentAccentBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding OutcomeSummaryLevel}"
                         Value="{x:Static statistics:TeamOutcomeSummaryLevel.InsufficientEvidence}">
                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="9" />
    </Style>
    <Style x:Key="TeamOutcomeSummaryPanelStyle" TargetType="Border"
           BasedOn="{StaticResource CardStyle}">
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasOutcomeSummary}" Value="False">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="MetricCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
        <Setter Property="Padding" Value="12,8" />
    </Style>
    <Style x:Key="MetricValueStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="ChampionNameStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="4,6,4,0" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="RoleTitleStyle" TargetType="TextBlock">
        <Setter Property="Text" Value="{Binding Role, StringFormat={}{0}  ›}"/>
        <Style.Triggers><DataTrigger Binding="{Binding CanOpenDetail}" Value="False"><Setter Property="Text" Value="{Binding Role}"/></DataTrigger></Style.Triggers>
    </Style>
    <Style x:Key="RoleCardButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Stretch"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#101B25"/><Setter TargetName="Chrome" Property="BorderBrush" Value="#4A6171"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#172532"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource GoldAccentBrush}"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Cursor" Value="Arrow"/><Setter TargetName="Chrome" Property="BorderBrush" Value="Transparent"/><Setter TargetName="Chrome" Property="Background" Value="Transparent"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>

    <DataTemplate x:Key="MetricCardTemplate">
        <Border Style="{StaticResource MetricCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.ColumnSpan="3" Text="{Binding Label}"
                           Style="{StaticResource SecondaryTextStyle}"
                           FontWeight="SemiBold" />
                <TextBlock Grid.Row="1" Margin="0,3,0,0" Text="{Binding QueryValue}"
                           Style="{StaticResource MetricValueStyle}"
                           Foreground="{StaticResource QueryAccentBrush}" />
                <Border Grid.Row="1" Grid.Column="1" Width="1" Height="18"
                        Margin="0,3,0,0" Background="#354052"
                        HorizontalAlignment="Center" />
                <TextBlock Grid.Row="1" Grid.Column="2" Margin="0,3,0,0"
                           Text="{Binding OpponentValue}"
                           Style="{StaticResource MetricValueStyle}"
                           Foreground="{StaticResource OpponentAccentBrush}"
                           TextAlignment="Right" />
                <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Margin="0,2,0,0"
                           Text="{Binding DetailText}"
                           Style="{StaticResource MutedTextStyle}"
                           TextAlignment="Center" TextWrapping="Wrap" />
            </Grid>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="CompactMetricRowTemplate">
        <Grid Margin="0,2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="92" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Label}" Style="{StaticResource MutedTextStyle}"
                       VerticalAlignment="Center" TextWrapping="Wrap" ToolTip="{Binding Label}" />
            <TextBlock Grid.Column="1" Text="{Binding QueryValue}"
                       Foreground="{StaticResource QueryAccentBrush}" FontSize="12"
                       FontWeight="SemiBold" TextAlignment="Right" />
            <TextBlock Grid.Column="3" Text="{Binding OpponentValue}"
                       Foreground="{StaticResource OpponentAccentBrush}" FontSize="12"
                       FontWeight="SemiBold" TextAlignment="Right" />
            <TextBlock Grid.Row="1" Grid.ColumnSpan="4" Text="{Binding DetailText}"
                       Style="{StaticResource MutedTextStyle}" FontSize="9"
                       HorizontalAlignment="Right" />
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="RoleDashboardCardTemplate">
        <Button Style="{StaticResource RoleCardButtonStyle}" IsEnabled="{Binding CanOpenDetail}"
                Command="{Binding RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Path=RoleSelectionCommand}"
                CommandParameter="{Binding}">
        <Border Style="{StaticResource CardStyle}" Padding="12,10">
            <StackPanel>
                <Grid>
                    <TextBlock Style="{StaticResource RoleTitleStyle}" Foreground="{StaticResource GoldAccentBrush}"
                               FontSize="12" FontWeight="SemiBold" />
                    <Border Style="{StaticResource OutcomeBadgeStyle}"
                            HorizontalAlignment="Right"
                            ToolTip="{Binding OutcomeAdvantageDescription}">
                        <TextBlock Text="{Binding OutcomeAdvantageText}"
                                   Style="{StaticResource OutcomeBadgeTextStyle}" />
                    </Border>
                </Grid>
                <Grid Margin="0,4,0,0">
                    <Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding HasStatistics}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding LevelTempoText, StringFormat=초반  {0}}"
                               Style="{StaticResource LevelTempoTextStyle}"
                               ToolTip="{Binding LevelTempoDescription}" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding CombatPressureText, StringFormat=교전  {0}}"
                               Style="{StaticResource CombatPressureTextStyle}"
                               TextAlignment="Right"
                               ToolTip="{Binding CombatPressureDescription}" />
                </Grid>
                <Grid Margin="0,7,0,0"><TextBlock Text="아군" Foreground="{StaticResource QueryAccentBrush}" FontSize="10"/><TextBlock Text="적군" HorizontalAlignment="Right" Foreground="{StaticResource OpponentAccentBrush}" FontSize="10"/></Grid>
                <Grid Margin="0,6,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="26" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="34" Height="34" CornerRadius="6" Background="#242C38"
                                ClipToBounds="True" BorderBrush="#354052" BorderThickness="1">
                            <Grid>
                                <TextBlock Text="?" Foreground="{StaticResource MutedTextBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image Source="{Binding QueryChampionIcon}" Stretch="UniformToFill" />
                            </Grid>
                        </Border>
                        <TextBlock Text="{Binding QueryChampionDisplayName}" MaxWidth="95" Margin="7,0,0,0"
                                   Foreground="{StaticResource QueryAccentBrush}" FontSize="13"
                                   FontWeight="SemiBold" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="VS" Foreground="{StaticResource MutedTextBrush}"
                               FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" FlowDirection="RightToLeft">
                        <controls:EnemyPortraitButton Style="{StaticResource RoleCardButtonStyle}"
                                    ToolTip="상대 챔피언 스킬 보기" AutomationProperties.Name="상대 챔피언 스킬 보기"
                                    Command="{Binding RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Path=EnemySelectionCommand}"
                                    CommandParameter="{Binding}"><Border Width="34" Height="34" CornerRadius="6" Background="#242C38"
                                ClipToBounds="True" BorderBrush="#354052" BorderThickness="1">
                            <Grid>
                                <TextBlock Text="?" Foreground="{StaticResource MutedTextBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image Source="{Binding OpponentChampionIcon}" Stretch="UniformToFill" />
                            </Grid>
                        </Border></controls:EnemyPortraitButton>
                        <TextBlock Text="{Binding OpponentChampionDisplayName}" MaxWidth="95" Margin="0,0,7,0"
                                   Foreground="{StaticResource OpponentAccentBrush}" FontSize="13"
                                   FontWeight="SemiBold" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" FlowDirection="LeftToRight" />
                    </StackPanel>
                </Grid>
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding SampleSizeText}" Style="{StaticResource MutedTextStyle}" />
                        <Border Style="{StaticResource ReliabilityBadgeStyle}" Margin="6,0,0,0"
                                ToolTip="{Binding ReliabilityDescription}">
                            <TextBlock Text="{Binding ReliabilityText}"
                                       Style="{StaticResource ReliabilityBadgeTextStyle}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="11" HorizontalAlignment="Right" />
                </Grid>
                <TextBlock Text="{Binding StatusDetailText}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
                <Separator Margin="0,5,0,3" Background="#293241" />
                <ItemsControl ItemsSource="{Binding DisplayMetrics}"
                              ItemTemplate="{StaticResource CompactMetricRowTemplate}" />
            </StackPanel>
        </Border>
        </Button>
    </DataTemplate>
</ResourceDictionary>
