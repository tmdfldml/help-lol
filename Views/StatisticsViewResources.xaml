<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F1F4F8" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#A5AFBD" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#707B8B" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#171D27" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#27303E" />
    <SolidColorBrush x:Key="QueryAccentBrush" Color="#82B8C5" />
    <SolidColorBrush x:Key="OpponentAccentBrush" Color="#B7A5CE" />
    <SolidColorBrush x:Key="GoldAccentBrush" Color="#D6B66B" />

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
    </Style>
    <Style x:Key="SecondaryTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style x:Key="MutedTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="FontSize" Value="11" />
    </Style>
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="9" />
    </Style>
    <Style x:Key="MetricCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
        <Setter Property="Padding" Value="12,8" />
    </Style>
    <Style x:Key="MetricValueStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="ChampionNameStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="4,6,4,0" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <DataTemplate x:Key="MetricCardTemplate">
        <Border Style="{StaticResource MetricCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.ColumnSpan="3" Text="{Binding Label}"
                           Style="{StaticResource SecondaryTextStyle}"
                           FontWeight="SemiBold" />
                <TextBlock Grid.Row="1" Margin="0,3,0,0" Text="{Binding QueryValue}"
                           Style="{StaticResource MetricValueStyle}"
                           Foreground="{StaticResource QueryAccentBrush}" />
                <Border Grid.Row="1" Grid.Column="1" Width="1" Height="18"
                        Margin="0,3,0,0" Background="#354052"
                        HorizontalAlignment="Center" />
                <TextBlock Grid.Row="1" Grid.Column="2" Margin="0,3,0,0"
                           Text="{Binding OpponentValue}"
                           Style="{StaticResource MetricValueStyle}"
                           Foreground="{StaticResource OpponentAccentBrush}"
                           TextAlignment="Right" />
                <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Margin="0,2,0,0"
                           Text="{Binding DetailText}"
                           Style="{StaticResource MutedTextStyle}"
                           TextAlignment="Center" TextWrapping="Wrap" />
            </Grid>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="CompactMetricRowTemplate">
        <Grid Margin="0,2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="92" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Label}" Style="{StaticResource MutedTextStyle}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="1" Text="{Binding QueryValue}"
                       Foreground="{StaticResource QueryAccentBrush}" FontSize="12"
                       FontWeight="SemiBold" TextAlignment="Right" />
            <TextBlock Grid.Column="3" Text="{Binding OpponentValue}"
                       Foreground="{StaticResource OpponentAccentBrush}" FontSize="12"
                       FontWeight="SemiBold" TextAlignment="Right" />
            <TextBlock Grid.Row="1" Grid.ColumnSpan="4" Text="{Binding DetailText}"
                       Style="{StaticResource MutedTextStyle}" FontSize="9"
                       HorizontalAlignment="Right" />
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="RoleDashboardCardTemplate">
        <Border Style="{StaticResource CardStyle}" Padding="12,10">
            <StackPanel>
                <TextBlock Text="{Binding Role}" Foreground="{StaticResource GoldAccentBrush}"
                           FontSize="12" FontWeight="SemiBold" />
                <Grid Margin="0,6,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="26" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="34" Height="34" CornerRadius="6" Background="#242C38"
                                ClipToBounds="True" BorderBrush="#354052" BorderThickness="1">
                            <Grid>
                                <TextBlock Text="?" Foreground="{StaticResource MutedTextBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image Source="{Binding QueryChampionIcon}" Stretch="UniformToFill" />
                            </Grid>
                        </Border>
                        <TextBlock Text="{Binding QueryChampionDisplayName}" Margin="7,0,0,0"
                                   Foreground="{StaticResource QueryAccentBrush}" FontSize="13"
                                   FontWeight="SemiBold" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="VS" Foreground="{StaticResource MutedTextBrush}"
                               FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" FlowDirection="RightToLeft">
                        <Border Width="34" Height="34" CornerRadius="6" Background="#242C38"
                                ClipToBounds="True" BorderBrush="#354052" BorderThickness="1">
                            <Grid>
                                <TextBlock Text="?" Foreground="{StaticResource MutedTextBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image Source="{Binding OpponentChampionIcon}" Stretch="UniformToFill" />
                            </Grid>
                        </Border>
                        <TextBlock Text="{Binding OpponentChampionDisplayName}" Margin="0,0,7,0"
                                   Foreground="{StaticResource OpponentAccentBrush}" FontSize="13"
                                   FontWeight="SemiBold" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" FlowDirection="LeftToRight" />
                    </StackPanel>
                </Grid>
                <Grid>
                    <TextBlock Text="{Binding SampleSizeText}" Style="{StaticResource MutedTextStyle}" />
                    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="11" HorizontalAlignment="Right" />
                </Grid>
                <Separator Margin="0,5,0,3" Background="#293241" />
                <ItemsControl ItemsSource="{Binding DisplayMetrics}"
                              ItemTemplate="{StaticResource CompactMetricRowTemplate}" />
            </StackPanel>
        </Border>
    </DataTemplate>
</ResourceDictionary>
