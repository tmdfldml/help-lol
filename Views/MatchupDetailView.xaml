<UserControl x:Class="LoLMatchup.Views.MatchupDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <DataTemplate x:Key="DetailMetricTemplate">
            <Border Style="{StaticResource CardStyle}" Padding="14,11" Margin="0,0,8,8">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.ColumnSpan="3" Text="{Binding Label}" Style="{StaticResource SecondaryTextStyle}" FontWeight="SemiBold"/>
                    <StackPanel Grid.Row="1" Margin="0,7,0,0">
                        <TextBlock Text="아군" Style="{StaticResource MutedTextStyle}"/>
                        <TextBlock Text="{Binding QueryValue}" Foreground="{StaticResource QueryAccentBrush}" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding QueryDetailText}" Foreground="{StaticResource MutedTextBrush}" FontSize="10"/>
                    </StackPanel>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="VS" Foreground="{StaticResource MutedTextBrush}" FontSize="8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,7,0,0">
                        <TextBlock Text="적군" Style="{StaticResource MutedTextStyle}" TextAlignment="Right"/>
                        <TextBlock Text="{Binding OpponentValue}" Foreground="{StaticResource OpponentAccentBrush}" FontSize="18" FontWeight="SemiBold" TextAlignment="Right"/>
                        <TextBlock Text="{Binding OpponentDetailText}" Foreground="{StaticResource MutedTextBrush}" FontSize="10" TextAlignment="Right"/>
                    </StackPanel>
                    <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Text="{Binding DetailText}" Margin="0,5,0,0"
                               Foreground="{StaticResource MutedTextBrush}" FontSize="10" TextAlignment="Center" TextWrapping="Wrap"/>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid>
            <Button Content="←  인게임" Style="{StaticResource ShellButtonStyle}"
                    Padding="10,5" HorizontalAlignment="Left" Click="Back_Click"/>
            <TextBlock x:Name="PageTitleText" Text="매치업 상세" HorizontalAlignment="Right"
                       VerticalAlignment="Center" Foreground="{StaticResource GoldAccentBrush}" FontWeight="SemiBold"/>
        </Grid>

        <ScrollViewer Grid.Row="1" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Style="{StaticResource CardStyle}" Padding="18,14">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel HorizontalAlignment="Center" MaxWidth="145">
                                <Border Width="72" Height="72" CornerRadius="10" Background="#242C38" ClipToBounds="True" BorderBrush="#354052" BorderThickness="1">
                                    <Grid><TextBlock Text="?" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image x:Name="AllyIcon" Stretch="UniformToFill"/></Grid>
                                </Border>
                                <TextBlock x:Name="AllyNameText" Margin="0,7,0,0" Foreground="{StaticResource QueryAccentBrush}" FontSize="17" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="AllyIdText" Foreground="{StaticResource MutedTextBrush}" FontSize="10" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="VS" Foreground="{StaticResource MutedTextBrush}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="2" HorizontalAlignment="Center" MaxWidth="145">
                                <Border Width="72" Height="72" CornerRadius="10" Background="#242C38" ClipToBounds="True" BorderBrush="#354052" BorderThickness="1">
                                    <Grid><TextBlock Text="?" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image x:Name="EnemyIcon" Stretch="UniformToFill"/></Grid>
                                </Border>
                                <TextBlock x:Name="EnemyNameText" Margin="0,7,0,0" Foreground="{StaticResource OpponentAccentBrush}" FontSize="17" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="EnemyIdText" Foreground="{StaticResource MutedTextBrush}" FontSize="10" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <TextBlock x:Name="SampleSizeText" Style="{StaticResource SecondaryTextStyle}"/>
                            <TextBlock x:Name="PatchText" HorizontalAlignment="Right" Style="{StaticResource MutedTextStyle}"/>
                        </Grid>
                        <Grid x:Name="ReliabilityPanel" Margin="0,8,0,0" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource ReliabilityBadgeStyle}"
                                    ToolTip="{Binding Text, ElementName=ReliabilityDescriptionText}">
                                <TextBlock x:Name="ReliabilityText"
                                           Style="{StaticResource ReliabilityBadgeTextStyle}" />
                            </Border>
                            <TextBlock x:Name="ReliabilityDescriptionText" Grid.Column="1"
                                       Margin="9,0,0,0" VerticalAlignment="Center"
                                       Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                        </Grid>
                        <Grid x:Name="OutcomePanel" Margin="0,8,0,0" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource OutcomeBadgeStyle}"
                                    ToolTip="게임 결과 승률과 표본 불확실성을 기준으로 판단합니다.">
                                <TextBlock x:Name="OutcomeText"
                                           Style="{StaticResource OutcomeBadgeTextStyle}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="9,0,0,0">
                                <TextBlock Text="게임 결과 경향" Style="{StaticResource SecondaryTextStyle}"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="OutcomeDescriptionText"
                                           Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                        <Grid x:Name="LevelTempoPanel" Margin="0,8,0,0" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="레벨 템포" Style="{StaticResource SecondaryTextStyle}"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="LevelTempoText"
                                           Style="{StaticResource LevelTempoTextStyle}" FontSize="11" />
                            </StackPanel>
                            <TextBlock x:Name="LevelTempoDescriptionText" Grid.Column="1"
                                       Margin="9,0,0,0" VerticalAlignment="Center"
                                       Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                        </Grid>
                        <Grid x:Name="CombatPressurePanel" Margin="0,8,0,0" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="교전 압박" Style="{StaticResource SecondaryTextStyle}"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="CombatPressureText"
                                           Style="{StaticResource CombatPressureTextStyle}" FontSize="11" />
                            </StackPanel>
                            <TextBlock x:Name="CombatPressureDescriptionText" Grid.Column="1"
                                       Margin="9,0,0,0" VerticalAlignment="Center"
                                       Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border x:Name="DetailStatusPanel" Style="{StaticResource CardStyle}" Padding="22" Margin="0,10,0,0" Visibility="Collapsed">
                    <StackPanel><TextBlock x:Name="DetailStatusText" Foreground="{StaticResource GoldAccentBrush}" FontSize="15" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock x:Name="DetailStatusDescription" Margin="0,7,0,0" Style="{StaticResource SecondaryTextStyle}" TextAlignment="Center" TextWrapping="Wrap"/></StackPanel>
                </Border>

                <ItemsControl x:Name="MetricsItems" Margin="0,10,0,0" ItemTemplate="{StaticResource DetailMetricTemplate}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemWidth="320"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                </ItemsControl>
                <TextBlock x:Name="SoloKillExplanation" Text="솔로킬은 게임 시작 후 15분 이전, 맞은편 역할 상대를 직접 처치한 이벤트입니다."
                           Margin="3,1,3,8" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
