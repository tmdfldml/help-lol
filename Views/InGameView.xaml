<UserControl x:Class="LoLMatchup.Views.InGameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:LoLMatchup.Views">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="인게임  ·  현재 게임의 포지션별 매치업"
                   Style="{StaticResource MutedTextStyle}" Margin="2,0,0,4"/>
        <Border x:Name="StatusPanel" Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                Padding="28,24" Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="12">
            <StackPanel>
                <TextBlock Text="{Binding StatusText, FallbackValue=게임을 기다리는 중입니다}"
                           Foreground="{StaticResource GoldAccentBrush}" FontSize="15"
                           FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding StatusDetailText, FallbackValue=리그 오브 레전드 게임이 시작되면 매치업 통계를 자동으로 표시합니다.}"
                           Margin="0,8,0,0" Style="{StaticResource SecondaryTextStyle}"
                           TextAlignment="Center" TextWrapping="Wrap" LineHeight="19"/>
            </StackPanel>
        </Border>
        <Grid x:Name="StatisticsPanel" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Style="{StaticResource TeamOutcomeSummaryPanelStyle}"
                    ToolTip="{Binding OutcomeSummaryDescription}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding OutcomeSummaryTitle}"
                               Style="{StaticResource SecondaryTextStyle}"
                               FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Border Grid.Column="1" HorizontalAlignment="Right"
                            Style="{StaticResource TeamOutcomeSummaryBadgeStyle}">
                        <TextBlock Text="{Binding OutcomeSummaryText}"
                                   Style="{StaticResource TeamOutcomeSummaryTextStyle}" />
                    </Border>
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,3,0,0"
                               Text="{Binding OutcomeSummaryEvidenceText, StringFormat=라인별 결과 경향 요약 · {0}}"
                               Style="{StaticResource MutedTextStyle}" FontSize="10"
                               TextWrapping="Wrap" />
                </Grid>
            </Border>
            <views:PortraitStatisticsView Grid.Row="1" x:Name="PortraitView"/>
            <views:LandscapeStatisticsView Grid.Row="1" x:Name="LandscapeView" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</UserControl>
