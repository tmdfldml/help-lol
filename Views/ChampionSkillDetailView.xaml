<UserControl x:Class="LoLMatchup.Views.ChampionSkillDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Button x:Name="BackButton" Content="←  인게임" Style="{StaticResource ShellButtonStyle}"
                HorizontalAlignment="Left" Padding="10,5" Click="Back_Click"/>
        <ScrollViewer x:Name="DetailScroll" Grid.Row="1" Margin="0,10,0,0"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Style="{StaticResource CardStyle}" Padding="14">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Image x:Name="ChampionIcon" Width="44" Height="44"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="상대 챔피언 · 스킬 정보" Foreground="{StaticResource OpponentAccentBrush}" FontSize="11"/>
                                <TextBlock x:Name="ChampionTitle" Foreground="{StaticResource PrimaryTextBrush}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="PatchText" Margin="0,10,0,0" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="WarningText" Margin="0,5,0,0" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="StatusText" Margin="0,12,0,0" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap">
                    <TextBlock.Style><Style TargetType="TextBlock">
                        <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
                    </Style></TextBlock.Style>
                </TextBlock>
                <ItemsControl x:Name="SpellList" Margin="0,10,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardStyle}" Padding="14" Margin="0,0,0,8">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Image Source="{Binding Icon}" Width="30" Height="30"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Spell.Key}" Foreground="{StaticResource OpponentAccentBrush}" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Spell.Name}" Foreground="{StaticResource PrimaryTextBrush}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    </Grid>
                                    <TextBlock Text="{Binding Spell.Description}" Margin="0,9,0,0" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" TextWrapping="Wrap"/>
                                    <StackPanel Margin="0,10,0,0">
                                        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Spell.IsCharge}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                        <TextBlock Text="{Binding Spell.ChargeText}" Foreground="{StaticResource OpponentAccentBrush}" FontSize="12" TextWrapping="Wrap"/>
                                        <TextBlock Text="충전 시간" Margin="0,8,0,3" Style="{StaticResource MutedTextStyle}"/>
                                        <TextBlock Text="{Binding Spell.RechargeText}" Foreground="{StaticResource QueryAccentBrush}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <TextBlock Text="재사용 대기시간" Margin="0,10,0,3" Style="{StaticResource MutedTextStyle}"/>
                                    <TextBlock Text="{Binding Spell.CooldownText}" Foreground="{StaticResource QueryAccentBrush}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <StackPanel Margin="0,8,0,0">
                                        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Spell.HasBaseCooldown}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                        <TextBlock Text="진화 전 재사용 대기시간" Style="{StaticResource MutedTextStyle}"/>
                                        <TextBlock Text="{Binding Spell.BaseCooldownText}" Foreground="{StaticResource QueryAccentBrush}" FontSize="16" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Style="{StaticResource CardStyle}" Padding="14" Margin="0,2,0,10">
                    <StackPanel>
                        <TextBlock Text="스킬 마스터 순서" Foreground="{StaticResource OpponentAccentBrush}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock x:Name="OrderText" Margin="0,9,0,0" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="SequenceText" Margin="0,5,0,0" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="SourceText" Margin="0,5,0,0" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
