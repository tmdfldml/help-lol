<UserControl x:Class="LoLMatchup.Views.PortraitStatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:LoLMatchup.Views.Controls">
    <UserControl.Resources>
        <Style x:Key="HideWhenEmptyStyle" TargetType="TextBlock">
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PortraitSummaryLabelStyle" TargetType="TextBlock"
               BasedOn="{StaticResource MutedTextStyle}">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <DataTemplate x:Key="PortraitRoleCardTemplate">
            <Button Style="{StaticResource RoleCardButtonStyle}"
                    IsEnabled="{Binding CanOpenDetail}"
                    Command="{Binding RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Path=RoleSelectionCommand}"
                    CommandParameter="{Binding}">
                <Border Style="{StaticResource CardStyle}" Padding="9,4">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RoleTitleStyle}"
                                       Foreground="{StaticResource GoldAccentBrush}"
                                       FontSize="11" FontWeight="SemiBold" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                        HorizontalAlignment="Right">
                                <TextBlock Text="{Binding SampleSizeText}"
                                           Style="{StaticResource MutedTextStyle}" />
                                <Border Style="{StaticResource ReliabilityBadgeStyle}"
                                        Margin="6,0,0,0"
                                        ToolTip="{Binding ReliabilityDescription}">
                                    <TextBlock Text="{Binding ReliabilityText}"
                                               Style="{StaticResource ReliabilityBadgeTextStyle}" />
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,2,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="28" Height="28" CornerRadius="5"
                                        Background="#242C38" ClipToBounds="True"
                                        BorderBrush="#354052" BorderThickness="1">
                                    <Grid>
                                        <TextBlock Text="?"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                        <Image Source="{Binding QueryChampionIcon}"
                                               Stretch="UniformToFill" />
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding QueryChampionDisplayName}" MaxWidth="100"
                                           Margin="6,0,0,0"
                                           Foreground="{StaticResource QueryAccentBrush}"
                                           FontSize="12" FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="VS"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="9" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal"
                                        FlowDirection="RightToLeft">
                                <controls:EnemyPortraitButton Style="{StaticResource RoleCardButtonStyle}"
                                    ToolTip="상대 챔피언 스킬 보기" AutomationProperties.Name="상대 챔피언 스킬 보기"
                                    Command="{Binding RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Path=EnemySelectionCommand}"
                                    CommandParameter="{Binding}"><Border Width="28" Height="28" CornerRadius="5"
                                        Background="#242C38" ClipToBounds="True"
                                        BorderBrush="#354052" BorderThickness="1">
                                    <Grid>
                                        <TextBlock Text="?"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                        <Image Source="{Binding OpponentChampionIcon}"
                                               Stretch="UniformToFill" />
                                    </Grid>
                                </Border></controls:EnemyPortraitButton>
                                <TextBlock Text="{Binding OpponentChampionDisplayName}" MaxWidth="100"
                                           Margin="0,0,6,0"
                                           Foreground="{StaticResource OpponentAccentBrush}"
                                           FontSize="12" FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           FlowDirection="LeftToRight" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{Binding StatusText}"
                                   HorizontalAlignment="Center"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="11"
                                   Style="{StaticResource HideWhenEmptyStyle}" />

                        <TextBlock Text="{Binding StatusDetailText}" TextWrapping="Wrap" TextAlignment="Center"
                                   Foreground="{StaticResource MutedTextBrush}" FontSize="11"
                                   Style="{StaticResource HideWhenEmptyStyle}" />

                        <Grid Margin="0,0,0,3">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasOutcomeEvaluation}"
                                                     Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="18" />
                                <RowDefinition Height="18" />
                                <RowDefinition Height="18" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="결과" ToolTip="이 조합의 게임 승률 경향입니다. 판정 보류는 표본이 부족해 방향을 판단하지 않는다는 뜻입니다."
                                       Style="{StaticResource PortraitSummaryLabelStyle}" />
                            <TextBlock Grid.Column="1" Text="{Binding OutcomeAdvantageText}"
                                       Style="{StaticResource OutcomeBadgeTextStyle}"
                                       FontSize="13" VerticalAlignment="Center"
                                       TextWrapping="NoWrap" TextTrimming="None"
                                       ToolTip="{Binding OutcomeAdvantageDescription}" />
                            <TextBlock Grid.Row="1" Text="초반" ToolTip="맞상대보다 2·3·6레벨에 먼저 도달한 경향입니다."
                                       Style="{StaticResource PortraitSummaryLabelStyle}" />
                            <TextBlock Grid.Row="1" Grid.Column="1"
                                       Text="{Binding LevelTempoText}"
                                       Style="{StaticResource LevelTempoTextStyle}"
                                       FontSize="13" VerticalAlignment="Center"
                                       TextWrapping="NoWrap" TextTrimming="None"
                                       ToolTip="{Binding LevelTempoDescription}" />
                            <TextBlock Grid.Row="2" Text="교전" ToolTip="15분 이전, 도움 없이 같은 역할의 맞상대를 직접 처치한 솔로킬 기준입니다. 전체 팀 교전 능력을 뜻하지 않습니다."
                                       Style="{StaticResource PortraitSummaryLabelStyle}" />
                            <TextBlock Grid.Row="2" Grid.Column="1"
                                       Text="{Binding CombatPressureText}"
                                       Style="{StaticResource CombatPressureTextStyle}"
                                       FontSize="13" VerticalAlignment="Center"
                                       TextWrapping="NoWrap" TextTrimming="None"
                                       ToolTip="{Binding CombatPressureDescription}" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding DisplayCompactDirectionIndicators}"
                                      ItemTemplate="{StaticResource PortraitDirectionChipTemplate}">
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasCompactDirectionIndicators}"
                                                     Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="{Binding PatchDisplayText}"
                   Style="{StaticResource MutedTextStyle}"
                   HorizontalAlignment="Right" Margin="0,0,2,5" />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding DisplayMatchups}"
                          ItemTemplate="{StaticResource PortraitRoleCardTemplate}">
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Margin" Value="0,0,0,5" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
