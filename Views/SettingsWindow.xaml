<Window x:Class="LoLMatchup.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="설정" Width="700" Height="520" MinWidth="640" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#0D1118">
    <Window.Resources>
        <Style x:Key="SettingsButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="#242C38" />
            <Setter Property="BorderBrush" Value="#3A4658" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#303A49" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#3A485A" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#606A79" />
                                <Setter TargetName="Chrome" Property="Background" Value="#171D27" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="54" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="Background" Value="#202733" />
            <Setter Property="BorderBrush" Value="#3A4658" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Content" Value="OFF" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="13">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Content" Value="ON" />
                                <Setter Property="Foreground" Value="#0D1118" />
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource GoldAccentBrush}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource GoldAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource QueryAccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,18" />
        </Style>
        <Style x:Key="SettingCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Padding" Value="16,13" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1">
            <TextBlock Text="설정" FontSize="22" FontWeight="Bold"
                       Margin="22,0" VerticalAlignment="Center" />
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="#111721" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,1,0">
                <ListBox x:Name="NavigationList" Margin="12,16" Background="Transparent"
                         BorderThickness="0" Foreground="{StaticResource SecondaryTextBrush}"
                         SelectionChanged="NavigationList_SelectionChanged" SelectedIndex="0">
                    <ListBox.Resources>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="14,10"/><Setter Property="Margin" Value="0,0,0,4"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#27313E"/>
                                    <Setter Property="Foreground" Value="{StaticResource GoldAccentBrush}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#202936"/></Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.Resources>
                    <ListBoxItem Content="일반"/><ListBoxItem Content="화면"/>
                    <ListBoxItem Content="데이터"/><ListBoxItem Content="정보"/>
                </ListBox>
            </Border>
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="24,20,26,24">
                    <StackPanel x:Name="GeneralPanel">
                        <TextBlock Text="일반" Style="{StaticResource SectionTitleStyle}"/>
                        <Border Style="{StaticResource SettingCardStyle}">
                            <StackPanel>
                                <TextBlock Text="설정 저장 위치" FontWeight="SemiBold"/>
                                <TextBlock x:Name="SettingsPathText" Margin="0,7,0,0" TextWrapping="Wrap"
                                           Style="{StaticResource MutedTextStyle}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="설정 초기화" FontWeight="SemiBold"/>
                                    <TextBlock Text="모든 앱 설정을 공식 기본값으로 되돌립니다."
                                               Margin="0,5,12,0" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="초기화" Style="{StaticResource SettingsButtonStyle}"
                                        VerticalAlignment="Center" Click="ResetSettings_Click"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="DisplayPanel" Visibility="Collapsed">
                        <TextBlock Text="화면" Style="{StaticResource SectionTitleStyle}"/>
                        <Border Style="{StaticResource SettingCardStyle}"><Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="항상 위에 표시" FontWeight="SemiBold"/><TextBlock Text="다른 창보다 위에 LoL Matchup을 유지합니다." Margin="0,4,12,0" Style="{StaticResource MutedTextStyle}"/></StackPanel>
                            <ToggleButton x:Name="AlwaysOnTopSettingToggle" Grid.Column="1" Style="{StaticResource SettingsToggleStyle}" Checked="SettingToggle_Changed" Unchecked="SettingToggle_Changed"/>
                        </Grid></Border>
                        <Border Style="{StaticResource SettingCardStyle}"><Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="창 위치 기억" FontWeight="SemiBold"/><TextBlock Text="종료할 때 현재 창 위치를 기억합니다." Margin="0,4,12,0" Style="{StaticResource MutedTextStyle}"/></StackPanel>
                            <ToggleButton x:Name="RememberPositionToggle" Grid.Column="1" Style="{StaticResource SettingsToggleStyle}" Checked="SettingToggle_Changed" Unchecked="SettingToggle_Changed"/>
                        </Grid></Border>
                        <Border Style="{StaticResource SettingCardStyle}"><Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="창 크기 기억" FontWeight="SemiBold"/><TextBlock Text="종료할 때 현재 창 크기를 기억합니다." Margin="0,4,12,0" Style="{StaticResource MutedTextStyle}"/></StackPanel>
                            <ToggleButton x:Name="RememberSizeToggle" Grid.Column="1" Style="{StaticResource SettingsToggleStyle}" Checked="SettingToggle_Changed" Unchecked="SettingToggle_Changed"/>
                        </Grid></Border>
                        <Border Style="{StaticResource SettingCardStyle}"><Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="최근 세로형 크기" Style="{StaticResource SecondaryTextStyle}"/><TextBlock x:Name="PortraitSizeText" Margin="0,3,0,8" FontWeight="SemiBold"/><TextBlock Text="최근 가로형 크기" Style="{StaticResource SecondaryTextStyle}"/><TextBlock x:Name="LandscapeSizeText" Margin="0,3,0,0" FontWeight="SemiBold"/></StackPanel>
                            <TextBlock x:Name="LastLayoutText" Grid.Column="1" VerticalAlignment="Top" Style="{StaticResource MutedTextStyle}"/>
                        </Grid></Border>
                    </StackPanel>

                    <StackPanel x:Name="DataPanel" Visibility="Collapsed">
                        <TextBlock Text="데이터" Style="{StaticResource SectionTitleStyle}"/>
                        <Border Style="{StaticResource SettingCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="135"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <TextBlock Text="데이터 상태" Style="{StaticResource SecondaryTextStyle}"/><TextBlock x:Name="DatasetStatusText" Grid.Column="1" FontWeight="SemiBold"/>
                                <TextBlock Grid.Row="1" Text="현재 패치" Margin="0,10,0,0" Style="{StaticResource SecondaryTextStyle}"/><TextBlock x:Name="DatasetPatchText" Grid.Row="1" Grid.Column="1" Margin="0,10,0,0"/>
                                <TextBlock Grid.Row="2" Text="앱 적용 경기 수" Margin="0,10,0,0" Style="{StaticResource SecondaryTextStyle}"/><TextBlock x:Name="AcceptedMatchesText" Grid.Row="2" Grid.Column="1" Margin="0,10,0,0"/>
                                <TextBlock Grid.Row="3" Text="대상 티어" Margin="0,10,0,0" Style="{StaticResource SecondaryTextStyle}"/><TextBlock x:Name="TierScopeText" Grid.Row="3" Grid.Column="1" Margin="0,10,0,0"/>
                                <TextBlock Grid.Row="4" Text="최소 경기 길이" Margin="0,10,0,0" Style="{StaticResource SecondaryTextStyle}"/><TextBlock x:Name="DurationPolicyText" Grid.Row="4" Grid.Column="1" Margin="0,10,0,0"/>
                                <TextBlock Grid.Row="5" Text="데이터 위치" Margin="0,10,0,0" Style="{StaticResource SecondaryTextStyle}"/><TextBlock x:Name="DatasetSourceText" Grid.Row="5" Grid.Column="1" Margin="0,10,0,0"/>
                                <TextBlock Grid.Row="6" Text="데이터 버전" Margin="0,10,0,0" Style="{StaticResource SecondaryTextStyle}"/><TextBlock x:Name="DatasetRevisionText" Grid.Row="6" Grid.Column="1" Margin="0,10,0,0"/>
                                <TextBlock Grid.Row="7" Text="데이터 생성" Margin="0,10,0,0" Style="{StaticResource SecondaryTextStyle}"/><TextBlock x:Name="DatasetGeneratedAtText" Grid.Row="7" Grid.Column="1" Margin="0,10,0,0"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingCardStyle}">
                            <StackPanel>
                                <TextBlock x:Name="UpdateStatusText" Text="업데이트를 수동으로 확인할 수 있습니다."
                                           Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button x:Name="CheckUpdateButton" Content="업데이트 확인"
                                            Style="{StaticResource SettingsButtonStyle}" Click="CheckUpdate_Click"/>
                                    <Button x:Name="InstallUpdateButton" Content="업데이트 적용" Margin="8,0,0,0"
                                            Style="{StaticResource SettingsButtonStyle}" Click="InstallUpdate_Click"
                                            Visibility="Collapsed"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="AboutPanel" Visibility="Collapsed">
                        <TextBlock Text="정보" Style="{StaticResource SectionTitleStyle}"/>
                        <Border Style="{StaticResource SettingCardStyle}" Padding="20">
                            <StackPanel>
                                <TextBlock Text="LoL Matchup" FontSize="23" FontWeight="Bold"/>
                                <TextBlock x:Name="VersionText" Margin="0,8,0,0" Foreground="{StaticResource GoldAccentBrush}"/>
                                <TextBlock Text="Windows desktop application" Margin="0,5,0,0" Style="{StaticResource SecondaryTextStyle}"/>
                                <Separator Margin="0,18" Background="{StaticResource CardBorderBrush}"/>
                                <TextBlock Text="LoL Matchup은 Riot Games의 공식 앱이 아닙니다."
                                           Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
